---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import {site} from '../data/site';
import {projects} from '../data/projects';
import {getPosts} from '../lib/posts';
import {path} from '../lib/urls';
import {langOf} from '../lib/lang';
import heroArt from '../assets/hero-handdrawn.webp';
const posts = await getPosts();
---
<Base title={site.name}>
  <section class="hero">
    <img class="hero-art" src={heroArt.src} width={heroArt.width} height={heroArt.height} alt="" aria-hidden="true" loading="eager" fetchpriority="high" />
    <div class="hero-inner entrance">
      <h1 lang={langOf(site.name)}>{site.name}</h1>
      <p class="intro">{site.description}</p>
      <div class="hero-links"><a class="text-link" href={posts.length > 0 ? path('posts/') : path('about/')}>{posts.length > 0 ? '阅读文章' : '关于作者'}</a></div>
    </div>
  </section>
  {projects.length > 0 && <section id="projects" class:list={['home-section', {'single-project': projects.length === 1}]}>
    <div class="section-heading"><h2>精选作品</h2></div>
    <div class="project-grid">{projects.map((p,i) => <div class:list={[{'entrance':i<3}]} style={`--delay:${(i+1)*40}ms`}><ProjectCard project={p} eager={i===0} /></div>)}</div>
  </section>}
  {posts.length > 0 ? <section class="home-section">
    <div class="section-heading"><h2>最近文章</h2><a href={path('posts/')}>全部文章</a></div>
    <PostList posts={posts.slice(0,3)} />
  </section> : <p class="home-empty">暂无已发布文章。</p>}
</Base>
